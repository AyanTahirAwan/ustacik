</head>
<body>
  @include('partials/header')

  <main class="craftsman-account-shell">
    <section class="craftsman-account-frame">
      @include('partials/flash_alerts')

      <div class="craftsman-account-topbar">
        <div class="craftsman-account-heading">
          <p>{{ t('craftsman.account') }}</p>
          <h1>{{ $props.get('title') ?? t('craftsman.account') }}</h1>
        </div>

        <nav class="craftsman-account-nav" aria-label="Craftsman account navigation">
          <a href="/craftsman">
            {{ t('nav.dashboard') }}
          </a>

          <a
            href="/craftsman/profile"
            class="{{ $props.get('active') === 'profile' ? 'is-active' : '' }}"
          >
            {{ t('craftsman.my_profile') }}
          </a>

          <a
            href="/craftsman/work-photos"
            class="{{ $props.get('active') === 'work-photos' ? 'is-active' : '' }}"
          >
            {{ t('nav.work_photos') }}
          </a>

          <a
            href="/craftsman/subscription"
            class="{{ $props.get('active') === 'subscription' ? 'is-active' : '' }}"
          >
            {{ t('craftsman.subscription') }}
          </a>
        </nav>
      </div>

      <div class="craftsman-account-content">
        {{{ await $slots.main() }}}
      </div>
    </section>
