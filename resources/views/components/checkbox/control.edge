@assign($context.counter = $context.counter + 1)
@let(classes = [$props.get('class')].filter(Boolean))

<input {{
  $props
    .except(['type'])
    .merge({
      type: 'checkbox',
      name: $context.name,
      id: $context.id,
      class: classes,
      checked: $context.oldValue && $context.oldValue.includes($props.get('value')),
    })
    .toAttrs()
}} />
