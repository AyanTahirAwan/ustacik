@let(activeSection = $props.get('active'))
@let(adminProfile = auth.user ? await auth.user.related('admin').query().first() : null)
@let(adminName = adminProfile?.fullName?.trim() || auth.user?.email || 'Administrator')
@let(adminInitials = adminName
  .split(' ')
  .filter((part) => part.length > 0)
  .slice(0, 2)
  .map((part) => part.charAt(0))
  .join('')
  .toUpperCase())
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{{ $props.get('title') ?? 'Admin' }} — ustacik.com</title>
    @if(activeSection === 'users')
      @vite([
        'resources/css/app.css',
        'resources/css/admin-dashboard.css',
        'resources/css/admin-users.css',
        'resources/js/app.js',
        'resources/js/admin-dashboard.js',
      ])
    @else
      @vite(['resources/css/admin-dashboard.css', 'resources/js/admin-dashboard.js'])
    @end
    @stack('dumper')
  </head>
  <body class="admin-dashboard-body">
    <header class="admin-topbar">
      <div class="admin-topbar-inner">
        <div class="admin-brand-lockup">
          <a class="admin-brand" href="/admin" aria-label="ustacik.com Admin home">
            ustacik<span class="admin-brand-dot">.</span>com
          </a>
          <span class="admin-badge">Admin</span>
        </div>

        <nav class="admin-topnav" aria-label="Admin navigation">
          <a href="/admin" aria-current="{{ activeSection === 'dashboard' ? 'page' : 'false' }}">
            Dashboard
          </a>
          <a href="/admin/users" aria-current="{{ activeSection === 'users' ? 'page' : 'false' }}">
            User Management
          </a>
          <a href="/admin/categories">Categories</a>
          <a href="/admin/regions">Regions</a>
          <a href="/admin/sub-services">Sub Services</a>
        </nav>

        <details class="admin-account-menu">
          <summary class="admin-avatar-chip" aria-label="{{ adminName }} account menu">
            {{ adminInitials }}
          </summary>

          <div class="admin-account-dropdown">
            <div class="admin-account-identity">
              <strong>{{ adminName }}</strong>
              <span>Admin</span>
            </div>
            @form({
              route: 'session.destroy',
              method: 'POST',
              class: 'admin-account-logout-form',
            })
              <button class="admin-account-action admin-account-logout" type="submit">
                Logout
              </button>
            @end
          </div>
        </details>
      </div>
    </header>
    @if(activeSection === 'users')
      <main class="admin-management-shell">
        <div class="admin-management-frame">
          @include('partials/flash_alerts')
          <section class="admin-management-content">{{{ await $slots.main() }}}</section>
        </div>
      </main>
    @else
      <main class="admin-dashboard-main">{{{ await $slots.main() }}}</main>
    @end
  </body>
</html>
