@let(currentPath = request.url())
@if(auth.user && auth.user.role === 'craftsman')
  <details class="dashboard-sidebar craftsman-workspace-menu" open>
    <summary aria-expanded="true">
      <span>{{ t('nav.craftsman_workspace', {}, 'Craftsman Workspace') }}</span>
      <svg
        class="dropdown-chevron"
        width="16"
        height="16"
        viewBox="0 0 16 16"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M3.5 5.75 8 10.25l4.5-4.5"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </summary>
    <nav class="dashboard-nav" aria-label="Craftsman workspace">
      <a
        href="/craftsman"
        class="{{ currentPath === '/craftsman' ? 'current' : '' }}"
        aria-current="{{ currentPath === '/craftsman' ? 'page' : 'false' }}"
      >
        {{ t('nav.dashboard') }}
      </a>
      <a
        href="/craftsman/jobs"
        class="{{ currentPath.startsWith('/craftsman/jobs') ? 'current' : '' }}"
        aria-current="{{ currentPath.startsWith('/craftsman/jobs') ? 'page' : 'false' }}"
      >
        {{ t('nav.jobs') }}
      </a>
      <a
        href="/craftsman/service-prices"
        class="{{ currentPath.startsWith('/craftsman/service-prices') ? 'current' : '' }}"
        aria-current="{{
          currentPath.startsWith('/craftsman/service-prices')
            ? 'page'
            : 'false'
        }}"
      >
        {{ t('nav.prices') }}
      </a>
      <a
        href="/craftsman/work-photos"
        class="{{ currentPath.startsWith('/craftsman/work-photos') ? 'current' : '' }}"
        aria-current="{{ currentPath.startsWith('/craftsman/work-photos') ? 'page' : 'false' }}"
      >
        {{ t('nav.work_photos') }}
      </a>
      <a
        href="/craftsman/profile"
        class="{{ currentPath.startsWith('/craftsman/profile') ? 'current' : '' }}"
        aria-current="{{ currentPath.startsWith('/craftsman/profile') ? 'page' : 'false' }}"
      >
        {{ t('nav.profile') }}
      </a>
    </nav>
  </details>
@elseif(auth.user && auth.user.role === 'admin')
  <aside class="dashboard-sidebar">
    <nav class="dashboard-nav" aria-label="Admin workspace">
      <p class="nav-group-label">{{ t('admin.admin') }}</p>
      <a href="/admin">{{ t('admin.dashboard') }}</a>
      <a href="/admin/categories">{{ t('admin.categories') }}</a>
      <a href="/admin/regions">{{ t('admin.regions') }}</a>
      <a href="/admin/sub-services">{{ t('admin.sub_services') }}</a>
    </nav>
  </aside>
@end
