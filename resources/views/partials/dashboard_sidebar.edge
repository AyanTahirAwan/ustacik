<aside class="dashboard-sidebar">
  <nav class="dashboard-nav">
    @if(auth.user && auth.user.role === 'admin')
      <p class="nav-group-label">Admin</p>
      <a href="/admin">Dashboard</a>
      <a href="/admin/categories">Categories</a>
      <a href="/admin/regions">Regions</a>
      <a href="/admin/sub-services">Sub Services</a>
    @elseif(auth.user && auth.user.role === 'craftsman')
      <p class="nav-group-label">Craftsman</p>
      <a href="/craftsman">Dashboard</a>
      <a href="/craftsman/service-prices">My Service Prices</a>
    @else
      <p class="nav-group-label">Account</p>
      <a href="/login">Login</a>
      <a href="/signup">Signup</a>
    @end
  </nav>
</aside>

