@layout()
  <div class="hero">
    <h1>Categories</h1>
    <p>Browse all service categories.</p>
  </div>

  <section aria-labelledby="categories-heading">
    <h2 id="categories-heading" class="section-heading">Choose a service</h2>
    <p class="section-subheading">Select a category to explore the services available.</p>
    <div id="categories-list" class="catalog-grid" aria-live="polite">
      <div class="empty-state">
        <p>Loading categories…</p>
      </div>
    </div>
  </section>
@end
