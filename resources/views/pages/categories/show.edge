@layout()
  <div class="hero compact-hero">
    <a class="back-link" href="/categories">← All categories</a>
    <h1 id="category-title">Category services</h1>
    <p id="category-intro">Browse available services in this category.</p>
  </div>

  <section
    aria-labelledby="services-heading"
    data-category-id="{{ categoryId }}"
    id="category-detail"
  >
    <h2 id="services-heading" class="section-heading">Available services</h2>
    <div id="sub-services-list" class="catalog-grid" aria-live="polite">
      <div class="empty-state">
        <p>Loading services…</p>
      </div>
    </div>
  </section>
@end
