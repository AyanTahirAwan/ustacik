@customerAccountLayout({ title: t('customer.addresses', {}, 'My Addresses'), active: 'addresses' })
  <div id="customer-addresses-page">
    <p id="customer-addresses-loading" class="customer-addresses-loading">
      {{ t('btn.loading', {}, 'Loading addresses...') }}
    </p>

    <div
      id="customer-addresses-error"
      class="alert alert-destructive customer-addresses-message"
      hidden
    >
      <p id="customer-addresses-error-message">
        {{ t('notifications.error_load', {}, 'Unable to load your addresses. Please try again.') }}
      </p>
    </div>

    <div
      id="customer-addresses-success"
      class="alert alert-success customer-addresses-message"
      hidden
    >
      <p id="customer-addresses-success-message"></p>
    </div>

    <div id="customer-addresses-content" hidden>
      <div class="customer-addresses-grid">
        <section class="card customer-addresses-form-card">
          <div class="customer-addresses-section-header">
            <div>
              <h2 id="customer-address-form-title" class="card-title">{{ t('customer.add_address', {}, 'Add Address') }}</h2>
              <p class="card-description">
                {{ t('customer.add_address_sub', {}, 'Save an address to use when creating service requests.') }}
              </p>
            </div>
          </div>

          @form({
            action: '/api/customer/addresses',
            method: 'POST',
            id: 'customer-address-form',
            class: 'customer-address-form'
          })
            <div class="customer-address-fields">
              <div class="form-group customer-address-field">
                <label class="form-label" for="customer-address-region">{{ t('customer.region', {}, 'Region') }}</label>
                <select id="customer-address-region" class="form-control" required>
                  <option value="">{{ t('customer.select_region', {}, 'Select a region') }}</option>
                </select>
              </div>

              <div class="form-group customer-address-field">
                <label class="form-label" for="customer-address-label">{{ t('customer.label', {}, 'Label') }}</label>
                <input
                  id="customer-address-label"
                  class="form-control"
                  type="text"
                  maxlength="80"
                  placeholder="{{ t('customer.label_placeholder', {}, 'Home, Work...') }}"
                  required
                />
              </div>

              <div class="form-group customer-address-field customer-address-field-full">
                <label class="form-label" for="customer-address-street">{{ t('customer.street_address', {}, 'Street Address') }}</label>
                <textarea
                  id="customer-address-street"
                  class="form-control customer-address-textarea"
                  maxlength="200"
                  placeholder="{{ t('customer.street_placeholder', {}, 'Street, building and door number') }}"
                  required
                ></textarea>
              </div>

              <div class="form-group customer-address-field customer-address-field-full">
                <label class="form-label" for="customer-address-landmark">
                  {{ t('customer.landmark', {}, 'Landmark') }}
                  <span class="customer-address-optional">{{ t('customer.optional', {}, '(optional)') }}</span>
                </label>
                <input
                  id="customer-address-landmark"
                  class="form-control"
                  type="text"
                  maxlength="200"
                  placeholder="{{ t('customer.landmark_placeholder', {}, 'Nearby landmark or additional directions') }}"
                />
              </div>

              <div class="form-group customer-address-field customer-address-field-full">
                <div class="customer-address-checkbox">
                  <input
                    id="customer-address-default"
                    class="form-control customer-address-checkbox-input"
                    type="checkbox"
                  />
                  <label class="form-label" for="customer-address-default">
                    {{ t('customer.set_default', {}, 'Set as default address') }}
                  </label>
                </div>
              </div>
            </div>

            <div class="customer-address-form-actions">
              <button id="customer-address-submit" class="btn-primary" type="submit">
                {{ t('customer.save_address', {}, 'Save Address') }}
              </button>

              <button
                id="customer-address-cancel"
                class="btn-back"
                type="button"
                hidden
              >
                {{ t('customer.cancel_editing', {}, 'Cancel Editing') }}
              </button>
            </div>
          @end
        </section>

        <section class="card customer-addresses-list-card">
          <div class="customer-addresses-section-header">
            <div>
              <h2 class="card-title">{{ t('customer.saved_addresses', {}, 'Saved Addresses') }}</h2>
              <p class="card-description">
                {{ t('customer.manage_addresses', {}, 'Manage the addresses connected to your account.') }}
              </p>
            </div>

            <button id="customer-address-new" class="btn-primary" type="button">
              {{ t('customer.add_new', {}, 'Add New') }}
            </button>
          </div>

          <p id="customer-addresses-empty" class="customer-addresses-empty" hidden>
            {{ t('customer.no_addresses', {}, 'You have not saved any addresses yet.') }}
          </p>

          <div
            id="customer-addresses-list"
            class="customer-addresses-list"
            aria-live="polite"
          ></div>
        </section>
      </div>
    </div>
  </div>

  @vite(['resources/js/customer-addresses.js'])
@end
