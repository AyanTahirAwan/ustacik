@customerAccountLayout({ title: 'My Addresses', active: 'addresses' })
  <div id="customer-addresses-page">
    <p id="customer-addresses-loading" class="customer-addresses-loading">
      Loading addresses...
    </p>

    <div
      id="customer-addresses-error"
      class="alert alert-destructive customer-addresses-message"
      hidden
    >
      <p id="customer-addresses-error-message">
        Unable to load your addresses. Please try again.
      </p>
    </div>

    <div
      id="customer-addresses-success"
      class="alert alert-success customer-addresses-message"
      hidden
    >
      <p id="customer-addresses-success-message"></p>
    </div>

    <div id="customer-addresses-content" hidden>
      <div class="customer-addresses-grid">
        <section class="card customer-addresses-form-card">
          <div class="customer-addresses-section-header">
            <div>
              <h2 id="customer-address-form-title" class="card-title">Add Address</h2>
              <p class="card-description">
                Save an address to use when creating service requests.
              </p>
            </div>
          </div>

          @form({
            action: '/api/customer/addresses',
            method: 'POST',
            id: 'customer-address-form',
            class: 'customer-address-form'
          })
            <div class="customer-address-fields">
              <div class="form-group customer-address-field">
                <label class="form-label" for="customer-address-region">Region</label>
                <select id="customer-address-region" class="form-control" required>
                  <option value="">Select a region</option>
                </select>
              </div>

              <div class="form-group customer-address-field">
                <label class="form-label" for="customer-address-label">Label</label>
                <input
                  id="customer-address-label"
                  class="form-control"
                  type="text"
                  maxlength="80"
                  placeholder="Home, Work..."
                  required
                />
              </div>

              <div class="form-group customer-address-field customer-address-field-full">
                <label class="form-label" for="customer-address-street">Street Address</label>
                <textarea
                  id="customer-address-street"
                  class="form-control customer-address-textarea"
                  maxlength="200"
                  placeholder="Street, building and door number"
                  required
                ></textarea>
              </div>

              <div class="form-group customer-address-field customer-address-field-full">
                <label class="form-label" for="customer-address-landmark">
                  Landmark
                  <span class="customer-address-optional">(optional)</span>
                </label>
                <input
                  id="customer-address-landmark"
                  class="form-control"
                  type="text"
                  maxlength="200"
                  placeholder="Nearby landmark or additional directions"
                />
              </div>

              <div class="form-group customer-address-field customer-address-field-full">
                <div class="customer-address-checkbox">
                  <input
                    id="customer-address-default"
                    class="form-control customer-address-checkbox-input"
                    type="checkbox"
                  />
                  <label class="form-label" for="customer-address-default">
                    Set as default address
                  </label>
                </div>
              </div>
            </div>

            <div class="customer-address-form-actions">
              <button id="customer-address-submit" class="btn-primary" type="submit">
                Save Address
              </button>

              <button
                id="customer-address-cancel"
                class="btn-back"
                type="button"
                hidden
              >
                Cancel Editing
              </button>
            </div>
          @end
        </section>

        <section class="card customer-addresses-list-card">
          <div class="customer-addresses-section-header">
            <div>
              <h2 class="card-title">Saved Addresses</h2>
              <p class="card-description">
                Manage the addresses connected to your account.
              </p>
            </div>

            <button id="customer-address-new" class="btn-back" type="button">
              Add New
            </button>
          </div>

          <p id="customer-addresses-empty" class="customer-addresses-empty" hidden>
            You have not saved any addresses yet.
          </p>

          <div
            id="customer-addresses-list"
            class="customer-addresses-list"
            aria-live="polite"
          ></div>
        </section>
      </div>
    </div>
  </div>

  @vite(['resources/js/customer-addresses.js'])
@end
