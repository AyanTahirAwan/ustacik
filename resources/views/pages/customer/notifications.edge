@customerAccountLayout({ title: t('notifications.title', {}, 'Notifications'), active: 'notifications' })
  <div id="customer-notifications-page">
    <p id="customer-notifications-loading" class="customer-notifications-loading">
      {{ t('notifications.loading', {}, 'Loading notifications...') }}
    </p>

    <div
      id="customer-notifications-error"
      class="alert alert-destructive customer-notifications-message"
      hidden
    >
      <p id="customer-notifications-error-message">
        {{ t('notifications.error_load', {}, 'Unable to load your notifications. Please try again.') }}
      </p>
    </div>

    @form({
      action: '/api/notifications/read-all',
      method: 'PATCH',
      id: 'customer-notifications-csrf-form',
    })
    @end

    <section
      id="customer-notifications-content"
      class="card customer-notifications-card"
      hidden
    >
      <div class="customer-notifications-header">
        <div>
          <h2 class="card-title">{{ t('notifications.your_notifications') }}</h2>
          <p class="card-description">
            {{ t('notifications.your_notifications_sub') }}
          </p>
        </div>

        <div style="display: flex; align-items: center; gap: 12px;">
          <button id="customer-notifications-read-all" class="btn-back" type="button" hidden>
            {{ t('notifications.mark_all_read') }}
          </button>
          <span
            id="customer-notifications-unread-count"
            class="customer-notifications-count"
            hidden
          ></span>
        </div>
      </div>

      <p
        id="customer-notifications-empty"
        class="customer-notifications-empty"
        hidden
      >
        {{ t('notifications.empty', {}, 'You do not have any notifications yet.') }}
      </p>

      <div
        id="customer-notifications-list"
        class="customer-notifications-list"
        aria-live="polite"
      ></div>
    </section>
  </div>

  @vite(['resources/js/customer-notifications.js'])
@end
