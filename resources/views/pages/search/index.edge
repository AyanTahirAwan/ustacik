@layout()
  <section class="hero">
    <h1>{{ t('search.title') }}</h1>
    <p>{{ t('search.sub') }}</p>
  </section>

  <section class="search-section">
    <h2 class="section-heading">{{ t('search.find_service') }}</h2>
    <p class="section-subheading">{{ t('search.find_sub') }}</p>

    <div class="card">
      @form({
        method: 'GET',
        action: '/search',
        id: 'search-form',
      })
        <div class="form-group">
          @field.root({ name: 'categoryId' })
            @!field.label({ text: t('search.category'), class: 'form-label' })
            @!select.control({
              id: 'category-select',
              class: 'form-control',
              options: [{ value: '', name: t('btn.loading_categories') }],
            })
            @!field.error()
          @end
        </div>

        <div class="form-group">
          @field.root({ name: 'subServiceId' })
            @!field.label({ text: t('search.service'), class: 'form-label' })
            @!select.control({
              id: 'sub-service-select',
              class: 'form-control',
              disabled: true,
              options: [{ value: '', name: t('search.choose_cat_first') }],
            })
            @!field.error()
          @end
        </div>

        <div class="form-group">
          @field.root({ name: 'regionId' })
            @!field.label({ text: t('search.region'), class: 'form-label' })
            @!select.control({
              id: 'region-select',
              class: 'form-control',
              options: [{ value: '', name: t('btn.loading_regions') }],
            })
            @!field.error()
          @end
        </div>

        <div class="form-group">
          @field.root({ name: 'minPrice' })
            @!field.label({ text: t('search.min_price'), class: 'form-label' })
            @!input.control({
              class: 'form-control',
              type: 'number',
              placeholder: '0',
              min: '0',
              step: '1',
            })
            @!field.error()
          @end
        </div>

        <div class="form-group">
          @field.root({ name: 'maxPrice' })
            @!field.label({ text: t('search.max_price'), class: 'form-label' })
            @!input.control({
              class: 'form-control',
              type: 'number',
              placeholder: '1000',
              min: '0',
              step: '1',
            })
            @!field.error()
          @end
        </div>

        <div class="search-actions">
          <a href="/search" class="btn-back">{{ t('search.clear_filters') }}</a>
          @!button({
            text: t('search.search_btn'),
            type: 'submit',
            class: 'btn-primary',
          })
        </div>
      @end
    </div>
  </section>

  <section class="search-section">
    <h2 class="section-heading">{{ t('search.results') }}</h2>

    <div id="active-filters" class="active-filters" hidden>
      <strong>{{ t('search.active_filters') }}</strong>
      <span id="active-filter-values"></span>
    </div>

    <div id="search-results" class="results-grid" aria-live="polite">
      <div class="empty-state">
        <p>{{ t('search.use_filters') }}</p>
      </div>
    </div>
  </section>
@end
