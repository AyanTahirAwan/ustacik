@layout()
  <section class="hero">
    <h1>Search Services</h1>
    <p>Find craftsmen and compare service prices.</p>
  </section>

  <section class="search-section">
    <h2 class="section-heading">Find a Service</h2>
    <p class="section-subheading">Search by category, service, region, or price.</p>

    <div class="card">
      @form({
        method: 'GET',
        action: '/search',
        id: 'search-form',
      })
        <div class="form-group">
          @field.root({ name: 'categoryId' })
            @!field.label({ text: 'Category', class: 'form-label' })
            @!select.control({
              id: 'category-select',
              class: 'form-control',
              options: [{ value: '', name: 'Loading categories...' }],
            })
            @!field.error()
          @end
        </div>

        <div class="form-group">
          @field.root({ name: 'subServiceId' })
            @!field.label({ text: 'Service', class: 'form-label' })
            @!select.control({
              id: 'sub-service-select',
              class: 'form-control',
              disabled: true,
              options: [{ value: '', name: 'Choose a category first' }],
            })
            @!field.error()
          @end
        </div>

        <div class="form-group">
          @field.root({ name: 'regionId' })
            @!field.label({ text: 'Region', class: 'form-label' })
            @!select.control({
              id: 'region-select',
              class: 'form-control',
              options: [{ value: '', name: 'Loading regions...' }],
            })
            @!field.error()
          @end
        </div>

        <div class="form-group">
          @field.root({ name: 'minPrice' })
            @!field.label({ text: 'Minimum Price', class: 'form-label' })
            @!input.control({
              class: 'form-control',
              type: 'number',
              placeholder: '0',
              min: '0',
              step: '1',
            })
            @!field.error()
          @end
        </div>

        <div class="form-group">
          @field.root({ name: 'maxPrice' })
            @!field.label({ text: 'Maximum Price', class: 'form-label' })
            @!input.control({
              class: 'form-control',
              type: 'number',
              placeholder: '1000',
              min: '0',
              step: '1',
            })
            @!field.error()
          @end
        </div>

        <div class="search-actions">
          <a href="/search" class="btn-back">Clear filters</a>
          @!button({
            text: 'Search',
            type: 'submit',
            class: 'btn-primary',
          })
        </div>
      @end
    </div>
  </section>

  <section class="search-section">
    <h2 class="section-heading">Search Results</h2>

    <div id="search-results" class="results-grid" aria-live="polite">
      <div class="empty-state">
        <p>Use the filters above to find available services.</p>
      </div>
    </div>
  </section>
@end
