@layout()
  <section class="hero-ad-banner">
    <h2>Advertisement</h2>
    <p>Welcome to Ustacik! Find trusted home repair professionals or join our craftsman network today.</p>
  </section>

  <div class="card-grid">
    <div class="card">
      <div>
        <h2 class="card-title">Join the team</h2>
        <p class="card-description">
          Are you a qualified professional looking for work? Register your business and discover nearby local service opportunities.
        </p>
      </div>
      <div class="action-container">
        @!link({ route: 'new_account.create', text: 'Get Started →', class: 'btn-primary' })
      </div>
    </div>

    <div class="card">
      <div>
        <h2 class="card-title">Get a service</h2>
        <p class="card-description">
          Need something fixed or installed? Browse our specialized service categories to find top-rated local craftsmen.
        </p>
      </div>
      <div class="action-container">
        @!link({ route: 'home', text: 'Browse Services →', class: 'btn-primary' })
      </div>
    </div>
  </div>
@end
