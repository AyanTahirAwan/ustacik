          <div class="landing-feature-card">
            <span class="landing-feature-icon">💬</span>
            <div class="landing-feature-text">
              <strong>{{ lang === 'tr' ? 'Hızlı İletişim' : 'Direct Contact' }}</strong>
              <span>{{ lang === 'tr' ? 'Tek tıkla WhatsApp veya talep oluşturma' : 'One-click WhatsApp or job request' }}</span>
            </div>
          </div>
        </div>
      </div>
      <div class="action-container">
        @!link({ href: '/craftsmen', text: t('home.craftsmen_btn', {}, 'Browse Craftsmen'), class: 'btn-primary' })
      </div>
    </section>

    <!-- 5. Search Section -->
    <section id="search" class="landing-block">
      <div class="landing-block-header">
        <h2 class="landing-block-title">{{ t('home.search_title', {}, 'Find What You Need') }}</h2>
        <p class="landing-block-desc">
          {{ t('home.search_desc', {}, 'Looking for something specific? Use our search to quickly find craftsmen and services based on what you need. Search, filter, and explore your options all in one place.') }}
        </p>
      </div>
      <div class="action-container">
        @!link({ href: '/search', text: t('home.search_btn', {}, 'Start Searching'), class: 'btn-primary' })
      </div>
    </section>
  </div>
@end
