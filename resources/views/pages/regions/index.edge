@layout()
  <div class="hero">
    <h1>Regions</h1>
    <p>Browse all service regions.</p>
  </div>

  <section aria-labelledby="regions-heading">
    <h2 id="regions-heading" class="section-heading">Find help nearby</h2>
    <p class="section-subheading">Choose a region to see matching services.</p>
    <div id="regions-list" class="catalog-grid" aria-live="polite">
      <div class="empty-state">
        <p>Loading regions…</p>
      </div>
    </div>
  </section>
@end
