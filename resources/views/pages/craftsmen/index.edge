@layout()
  <div class="hero">
    <h1>Craftsman Listings</h1>
    <p>Browse craftsmen and their service listings.</p>
  </div>

  <section aria-labelledby="craftsmen-heading">
    <div class="section-header">
      <div>
        <h2 id="craftsmen-heading" class="section-heading">Local professionals</h2>
        <p class="section-subheading">Review profiles and find the right person for your job.</p>
      </div>
      <a class="btn-back" href="/search">Filter services</a>
    </div>
    <div id="craftsmen-list" class="craftsmen-grid" aria-live="polite">
      <div class="empty-state">
        <p>Loading craftsmen…</p>
      </div>
    </div>
  </section>
@end
