@dashboardLayout({ title: t('nav.dashboard', {}, 'Craftsman Dashboard') })
  <section class="craftsman-dashboard" data-dashboard>
    <div class="dashboard-intro">
      <div>
        <p class="dashboard-kicker">{{ t('craftsman.overview', {}, 'Overview') }}</p>
        <h2 id="dashboard-welcome">{{ t('craftsman.welcome_back', {}, 'Welcome back') }}</h2>
        <p id="dashboard-business" class="dashboard-subtitle">{{ t('btn.loading', {}, 'Loading your craftsman profile...') }}</p>
      </div>
      <span id="dashboard-trust" class="trust-badge">{{ t('btn.loading', {}, 'Loading') }}</span>
    </div>

    <div id="dashboard-error" class="dashboard-message dashboard-message-error" hidden></div>
    <div id="dashboard-loading" class="dashboard-message">{{ t('btn.loading', {}, 'Loading dashboard data...') }}</div>

    <div id="dashboard-content" hidden>
      <div class="dashboard-stats">
        <article class="dashboard-stat">
          <span>{{ t('craftsman.pending_requests', {}, 'Pending requests') }}</span><strong id="stat-pending">0</strong>
        </article>
        <article class="dashboard-stat">
          <span>{{ t('craftsman.completed_jobs', {}, 'Completed jobs') }}</span><strong id="stat-completed">0</strong>
        </article>
        <article class="dashboard-stat">
          <span>{{ t('craftsman.active_jobs', {}, 'Active jobs') }}</span><strong id="stat-active">0</strong>
        </article>
        <article class="dashboard-stat">
          <span>{{ t('craftsman.avg_rating', {}, 'Average rating') }}</span><strong id="stat-rating">—</strong>
        </article>
        <article class="dashboard-stat dashboard-stat-alert">
          <span>{{ t('craftsman.disputes', {}, 'Disputes') }}</span><strong id="stat-disputes">0</strong>
        </article>
      </div>

      <div class="dashboard-profile-grid">
        <article class="dashboard-panel dashboard-about">
          <div class="dashboard-panel-heading">
            <h3>{{ t('craftsman.about', {}, 'About') }}</h3>
            <a href="/craftsman/service-prices" class="action-link">{{ t('craftsman.manage_prices', {}, 'Manage prices') }}</a>
          </div>
          <p id="dashboard-about-text">No description provided.</p>
        </article>
        <article class="dashboard-panel">
          <h3>{{ t('craftsman.price_ranges', {}, 'Price ranges') }}</h3>
          <div id="dashboard-prices" class="dashboard-price-list">
            <p class="dashboard-muted">{{ t('craftsman.no_prices', {}, 'No active price entries.') }}</p>
          </div>
        </article>
      </div>

      <section class="dashboard-panel">
        <div class="dashboard-panel-heading">
          <h3>{{ t('craftsman.recent_job_requests', {}, 'Recent job requests') }}</h3>
          <div class="dashboard-heading-actions">
            <span id="dashboard-job-count" class="dashboard-muted"></span>
            <a href="/craftsman/jobs" class="action-link">{{ t('craftsman.manage_requests', {}, 'Manage requests') }}</a>
          </div>
        </div>
        <div class="dashboard-table-wrap">
          <table class="dashboard-table">
            <thead>
              <tr>
                <th>{{ t('craftsman.customer', {}, 'Customer') }}</th>
                <th>{{ t('craftsman.category', {}, 'Category') }}</th>
                <th>{{ t('craftsman.region', {}, 'Region') }}</th>
                <th>{{ t('craftsman.date_requested', {}, 'Date requested') }}</th>
                <th>{{ t('admin.status', {}, 'Status') }}</th>
                <th>{{ t('admin.account_actions', {}, 'Action') }}</th>
              </tr>
            </thead>
            <tbody id="dashboard-jobs"></tbody>
          </table>
        </div>
        <div id="dashboard-jobs-empty" class="dashboard-empty" hidden>{{ t('craftsman.no_jobs_yet', {}, 'No job requests yet.') }}</div>
      </section>

      <section class="dashboard-panel">
        <div class="dashboard-panel-heading">
          <h3>{{ t('craftsman.ratings', {}, 'Ratings') }}</h3>
          <span id="dashboard-review-count" class="dashboard-muted"></span>
        </div>
        <div id="dashboard-scores" class="dashboard-score-grid"></div>

        <div id="dashboard-reviews-section" style="margin-top: 24px;">
          <h4 style="margin: 0 0 14px 0; font-size: 1.05rem; color: #1e293b;">{{ t('craftsman.customer_reviews', {}, 'Customer Reviews & Dispute Responses') }}</h4>
          <div id="dashboard-reviews-list" style="display: flex; flex-direction: column; gap: 16px;"></div>
          <div id="dashboard-reviews-empty" class="dashboard-empty" hidden>{{ t('craftsman.no_ratings_yet', {}, 'No customer ratings yet.') }}</div>
        </div>
      </section>

      <section class="dashboard-panel">
        <div class="dashboard-panel-heading">
          <h3>{{ t('craftsman.previous_work', {}, 'Previous work') }}</h3>
          <a href="/craftsman/work-photos" class="action-link">{{ t('craftsman.manage_photos', {}, 'Manage photos') }}</a>
        </div>
        <div id="dashboard-photos" class="dashboard-photo-grid"></div>
        <div id="dashboard-photos-empty" class="dashboard-empty" hidden>
          {{ t('craftsman.no_photos', {}, 'No work photos uploaded yet.') }}
        </div>
      </section>

      <div class="dashboard-contact-row">
        <div>
          <h3>{{ t('craftsman.whatsapp_help', {}, 'Need a customer to contact you?') }}</h3>
          <p>{{ t('craftsman.whatsapp_sub', {}, 'Use WhatsApp with the phone number saved to your account.') }}</p>
        </div>
        <a
          id="dashboard-whatsapp"
          class="dashboard-whatsapp"
          href="#"
          target="_blank"
          rel="noopener"
          hidden
        >
          {{ t('craftsman.contact_whatsapp', {}, 'Contact via WhatsApp') }}
        </a>
      </div>
    </div>
  </section>

  <script>
    const loading = document.getElementById('dashboard-loading')
    const content = document.getElementById('dashboard-content')
    const errorBox = document.getElementById('dashboard-error')

    const escapeHtml = (value) => {
      const div = document.createElement('div')
      div.textContent = value ?? ''
      return div.innerHTML
    }

    const formatDate = (value) => {
      if (!value) return '—'
      const date = new Date(value)
      return Number.isNaN(date.getTime())
        ? '—'
        : date.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })
    }

    const statusClass = (status) => {
      if (status === 'pending') return 'status-pending'
      if (status === 'accepted' || status === 'in_progress' || status === 'completed') return 'status-active'
      if (status === 'disputed') return 'status-dispute'
      return ''
    }

    const statusLabel = (status) => {
      if (window.APP_LOCALE !== 'tr') return (status || '').replaceAll('_', ' ')
      const labels = {
        pending: 'Beklemede',
        accepted: 'Kabul Edildi',
        declined: 'Reddedildi',
        in_progress: 'Devam Ediyor',
        completed: 'Tamamlandı',
        cancelled: 'İptal Edildi',
        expired: 'Süresi Doldu',
        disputed: 'İtirazda',
      }
      return labels[status] || (status || '').replaceAll('_', ' ')
    }

    const average = (reviews) => {
      if (!reviews.length) return null
      const total = reviews.reduce(
        (sum, review) =>
          sum +
          Number(review.punctuality) +
          Number(review.workmanship) +
          Number(review.priceHonesty) +
          Number(review.communication),
        0,
      )
      return total / (reviews.length * 4)
    }

    const renderPrices = (prices) => {
      const container = document.getElementById('dashboard-prices')
      if (!prices.length) {
        container.innerHTML = `<p class="dashboard-muted">{{ t('craftsman.no_prices', {}, 'No active price entries.') }}</p>`
        return
      }
      container.innerHTML = prices
        .slice(0, 4)
        .map(
          (price) => `
            <div class="dashboard-price-item">
              <strong>${escapeHtml((window.APP_LOCALE === 'tr' ? price.subService?.nameTr : price.subService?.nameEn) || price.subService?.name || 'Service')}</strong>
              <span>${Number(price.minPrice).toFixed(0)} - ${Number(price.maxPrice).toFixed(0)} ${escapeHtml(price.currency || '')}</span>
            </div>`,
        )
        .join('')
    }

    const renderJobs = (jobs) => {
      const tbody = document.getElementById('dashboard-jobs')
      const empty = document.getElementById('dashboard-jobs-empty')
      const reqText = jobs.length === 1 ? "{{ t('craftsman.recent_request_single', {}, 'recent request') }}" : "{{ t('craftsman.recent_requests_plural', {}, 'recent requests') }}"
      document.getElementById('dashboard-job-count').textContent = `${jobs.length} ${reqText}`
      if (!jobs.length) {
        tbody.innerHTML = ''
        empty.hidden = false
        return
      }
      empty.hidden = true
      tbody.innerHTML = jobs
        .slice(0, 8)
        .map(
          (job) => `
            <tr>
              <td>${escapeHtml(job.customer?.fullName || "{{ t('craftsman.customer', {}, 'Customer') }}")}</td>
              <td>${escapeHtml((window.APP_LOCALE === 'tr' ? job.category?.nameTr : job.category?.nameEn) || job.category?.name || '—')}</td>
              <td>${escapeHtml((window.APP_LOCALE === 'tr' ? job.region?.nameTr : job.region?.nameEn) || job.region?.name || '—')}</td>
              <td>${formatDate(job.createdAt)}</td>
              <td><span class="status-badge ${statusClass(job.status)}">${escapeHtml(statusLabel(job.status))}</span></td>
              <td><a class="action-link" href="/craftsman/jobs">{{ t('craftsman.manage', {}, 'Manage') }}</a></td>
            </tr>`,
        )
        .join('')
    }

    const renderScores = (reviews) => {
      const container = document.getElementById('dashboard-scores')
      const labels = [
        ["{{ t('craftsman.quality', {}, 'Quality') }}", 'workmanship'],
        ["{{ t('craftsman.punctuality_rating', {}, 'Punctuality') }}", 'punctuality'],
        ["{{ t('craftsman.pricing', {}, 'Pricing') }}", 'priceHonesty'],
        ["{{ t('craftsman.communication_rating', {}, 'Communication') }}", 'communication'],
      ]
      if (!reviews.length) {
        container.innerHTML = `<p class="dashboard-muted">{{ t('craftsman.no_ratings_yet', {}, 'No customer ratings yet.') }}</p>`
        return
      }
      container.innerHTML = labels
        .map(([label, key]) => {
          const score = reviews.reduce((sum, review) => sum + Number(review[key]), 0) / reviews.length
          return `<div class="dashboard-score-card"><span>${label}</span><strong>${score.toFixed(1)}</strong></div>`
        })
        .join('')
    }

    const renderReviews = (reviews) => {
      const list = document.getElementById('dashboard-reviews-list')
      const empty = document.getElementById('dashboard-reviews-empty')
      if (!reviews.length) {
        list.innerHTML = ''
        empty.hidden = false
        return
      }
      empty.hidden = true
      list.innerHTML = reviews.map((review) => {
        const hasReply = Boolean(review.craftsmanReply && review.craftsmanReply.trim() !== '')
        const replyHtml = hasReply
          ? `<div class="craftsman-final-reply" style="margin-top: 12px; padding: 12px 16px; background-color: #f8fafc; border-left: 4px solid var(--brand-rust, #c85a32); border-radius: 4px;">
               <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                 <strong style="font-size: 0.85rem; color: var(--brand-rust, #c85a32); display: flex; align-items: center; gap: 4px;">
                   ✓ {{ t('craftsman.your_reply', {}, 'Your Response (Final & Published)') }}
                 </strong>
               </div>
               <p style="margin: 0; font-size: 0.9rem; color: #334155; white-space: pre-wrap;">${escapeHtml(review.craftsmanReply)}</p>
             </div>`
          : `<div id="reply-container-${review.id}" style="margin-top: 10px;">
               <button type="button" class="action-link toggle-reply-btn" data-review-id="${review.id}" style="background: none; border: none; font-size: 0.88rem; font-weight: 600; cursor: pointer; color: var(--brand-rust, #c85a32); display: inline-flex; align-items: center; gap: 4px; padding: 0;">
                 💬 {{ t('craftsman.reply_to_review', {}, 'Reply to this review') }}
               </button>
               <div id="reply-form-${review.id}" class="review-reply-form" data-review-id="${review.id}" style="margin-top: 10px; padding: 14px; background: #fff8f5; border: 1px dashed var(--brand-rust, #c85a32); border-radius: 8px;" hidden>
                 <p style="margin-top: 0; margin-bottom: 8px; font-size: 0.82rem; color: #8a5239; font-weight: 600;">
                   ⚠️ {{ t('craftsman.one_reply_warning', {}, 'Note: You can submit only ONE reply per review. Once submitted, it cannot be edited.') }}
                 </p>
                 <div id="reply-error-${review.id}" class="dashboard-message-error" style="font-size: 0.85rem; padding: 6px 10px; margin-bottom: 8px;" hidden></div>
                 <textarea id="reply-text-${review.id}" class="form-control" rows="3" required placeholder="{{ t('craftsman.reply_placeholder', {}, 'Write your response to this review...') }}" style="margin-bottom: 10px; font-size: 0.9rem; width: 100%; box-sizing: border-box;"></textarea>
                 <div style="display: flex; gap: 8px; justify-content: flex-end;">
                   <button type="button" class="btn-back cancel-reply-btn" data-review-id="${review.id}" style="padding: 6px 12px; font-size: 0.85rem;">{{ t('btn.cancel', {}, 'Cancel') }}</button>
                   <button type="button" class="btn-primary submit-reply-btn" data-review-id="${review.id}" onclick="window.handleReplySubmit(event, ${review.id})" style="padding: 6px 14px; font-size: 0.85rem;">{{ t('craftsman.submit_reply', {}, 'Submit Response') }}</button>
                 </div>
               </div>
             </div>`

        return `
          <article class="dashboard-review-card" style="padding: 16px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px; flex-wrap: wrap; gap: 8px;">
              <div>
                <strong style="color: #0f172a; font-size: 0.95rem;">${escapeHtml(review.customer?.fullName || "{{ t('craftsman.customer', {}, 'Customer') }}")}</strong>
                <span style="font-size: 0.8rem; color: #64748b; margin-left: 8px;">${formatDate(review.createdAt)}</span>
              </div>
              <span style="font-weight: 700; color: #b45309; background: #fef3c7; padding: 2px 8px; border-radius: 6px; font-size: 0.85rem;">
                ★ ${Number(review.average || 0).toFixed(1)} / 5.0
              </span>
            </div>
            <p style="margin: 0 0 8px 0; font-size: 0.92rem; color: #475569; line-height: 1.5;">${escapeHtml(review.comment || "{{ t('craftsman.no_comment', {}, 'No written comment.') }}")}</p>
            ${replyHtml}
          </article>
        `
      }).join('')
    }

    const renderPhotos = (photos) => {
      const container = document.getElementById('dashboard-photos')
      const empty = document.getElementById('dashboard-photos-empty')
      if (!photos.length) {
        container.innerHTML = ''
        empty.hidden = false
        return
      }
      empty.hidden = true
      container.innerHTML = photos
        .slice(0, 6)
        .map((photo) => `<img class="dashboard-work-photo" src="${escapeHtml(photo.imageUrl)}" alt="{{ t('craftsman.previous_work', {}, 'Previous work') }}">`)
        .join('')
    }

    const loadDashboard = async () => {
      try {
        const response = await fetch('/api/craftsman/dashboard', {
          headers: { Accept: 'application/json' },
          credentials: 'same-origin',
        })
        const data = await response.json().catch(() => ({}))
        if (!response.ok) throw new Error(data.message || "{{ t('dashboard.unable_to_load', {}, 'Unable to load dashboard.') }}")

        const { craftsman, jobs, reviews, stats } = data
        const rating = average(reviews)
        const welcomeText = "{{ t('craftsman.welcome_back', {}, 'Welcome back') }}"
        document.getElementById('dashboard-welcome').textContent = `${welcomeText}${craftsman.businessName ? `, ${craftsman.businessName}` : ''}`
        document.getElementById('dashboard-business').textContent = (window.APP_LOCALE === 'tr' ? craftsman.category?.nameTr : craftsman.category?.nameEn) || "{{ t('craftsman.account', {}, 'Craftsman Account') }}"
        
        const rawTrust = craftsman.trustLevelLabel || 'unverified'
        let trTrust = rawTrust.split('_').map((part) => part.charAt(0).toUpperCase() + part.slice(1)).join(' ')
        if (window.APP_LOCALE === 'tr') {
          if (rawTrust === 'unverified') trTrust = 'Doğrulanmamış'
          if (rawTrust === 'registered') trTrust = 'Kayıtlı'
          if (rawTrust === 'verified') trTrust = 'Doğrulanmış'
          if (rawTrust === 'approved') trTrust = 'Onaylı'
        }
        document.getElementById('dashboard-trust').textContent = trTrust
        document.getElementById('stat-pending').textContent = stats.pending
        document.getElementById('stat-completed').textContent = stats.completed
        document.getElementById('stat-active').textContent = stats.active
        document.getElementById('stat-disputes').textContent = stats.disputed
        document.getElementById('stat-rating').textContent = rating === null ? '—' : `${rating.toFixed(1)}/5`
        document.getElementById('dashboard-about-text').textContent = craftsman.bio || "{{ t('craftsman.no_desc', {}, 'No description provided.') }}"
        const revText = reviews.length === 1 ? "{{ t('craftsman.review_single', {}, 'review') }}" : "{{ t('craftsman.review_plural', {}, 'reviews') }}"
        document.getElementById('dashboard-review-count').textContent = `${reviews.length} ${revText}`
        renderPrices(craftsman.servicePriceCatalogs || [])
        renderJobs(jobs || [])
        renderScores(reviews || [])
        renderReviews(reviews || [])
        renderPhotos(craftsman.workPhotos || [])

        const phone = (craftsman.phone || '').replace(/[^\d]/g, '')
        if (phone) {
          const whatsapp = document.getElementById('dashboard-whatsapp')
          whatsapp.href = `https://wa.me/${phone}`
          whatsapp.hidden = false
        }
        loading.hidden = true
        content.hidden = false
      } catch (error) {
        loading.hidden = true
        errorBox.textContent = error.message || "{{ t('dashboard.unable_to_load', {}, 'Unable to load dashboard.') }}"
        errorBox.hidden = false
      }
    }

    window.handleReplySubmit = async (e, reviewId) => {
      if (e) {
        e.preventDefault()
        e.stopPropagation()
      }
      const form = document.getElementById(`reply-form-${reviewId}`)
      if (!form) return
      const textarea = document.getElementById(`reply-text-${reviewId}`) || form.querySelector('textarea')
      const submitBtn = document.querySelector(`.submit-reply-btn[data-review-id="${reviewId}"]`)
      const replyError = document.getElementById(`reply-error-${reviewId}`)
      const message = textarea ? textarea.value.trim() : ''
      
      if (!message) {
        textarea?.focus()
        return
      }

      if (submitBtn) submitBtn.disabled = true
      if (replyError) replyError.hidden = true
      errorBox.hidden = true

      const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') ||
                   document.querySelector('input[name="_csrf"]')?.value || ''

      try {
        const response = await fetch(`/api/reviews/${reviewId}/reply`, {
          method: 'PATCH',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json',
            'x-csrf-token': csrf,
          },
          credentials: 'same-origin',
          body: JSON.stringify({ message, _csrf: csrf }),
        })
        const data = await response.json().catch(() => ({}))
        if (!response.ok) {
          throw new Error(data.message || data.errors?.[0]?.message || "{{ t('dashboard.unable_to_save', {}, 'Unable to submit reply.') }}")
        }
        await loadDashboard()
      } catch (err) {
        const errMsg = err.message || "{{ t('dashboard.unable_to_save', {}, 'Unable to submit reply.') }}"
        if (replyError) {
          replyError.textContent = errMsg
          replyError.hidden = false
        } else {
          errorBox.textContent = errMsg
          errorBox.hidden = false
        }
        if (submitBtn) submitBtn.disabled = false
      }
    }

    document.addEventListener('click', (e) => {
      const toggleBtn = e.target.closest('.toggle-reply-btn')
      if (toggleBtn) {
        const id = toggleBtn.dataset.reviewId
        const form = document.getElementById(`reply-form-${id}`)
        if (form) {
          form.hidden = !form.hidden
          toggleBtn.hidden = !form.hidden
          if (!form.hidden) form.querySelector('textarea')?.focus()
        }
        return
      }

      const cancelBtn = e.target.closest('.cancel-reply-btn')
      if (cancelBtn) {
        const id = cancelBtn.dataset.reviewId
        const form = document.getElementById(`reply-form-${id}`)
        const toggle = document.querySelector(`.toggle-reply-btn[data-review-id="${id}"]`)
        if (form) form.hidden = true
        if (toggle) toggle.hidden = false
      }
    })

    document.addEventListener('submit', (e) => {
      const form = e.target.closest('.review-reply-form')
      if (form) {
        e.preventDefault()
        e.stopPropagation()
        const id = form.dataset.reviewId
        window.handleReplySubmit(e, id)
      }
    })

    loadDashboard()
  </script>
@end
