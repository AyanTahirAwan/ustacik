@dashboardLayout({ title: 'Edit Service Price' })
  <section class="service-price-page" data-price-id="{{ priceId }}" id="service-price-edit">
    <div class="service-price-toolbar"><a class="btn-back" href="/craftsman/service-prices">Back to My Service Prices</a></div>
    <div id="service-price-form-error" class="dashboard-message dashboard-message-error" hidden></div>
    <div id="service-price-form-loading" class="dashboard-message">Loading service price...</div>
    <div id="service-price-form-card" class="dashboard-panel service-price-form-card" hidden>
      @form({ method: 'POST', action: '/api/craftsman/service-prices', id: 'service-price-form' })
        <div class="service-price-form-grid">
          <label>Category<select id="price-category" class="form-control" required></select></label>
          <label>Service<select id="price-sub-service" name="subServiceId" class="form-control" required></select></label>
          <label>Region<select id="price-region" name="regionId" class="form-control" required></select></label>
          <label>Currency<select id="price-currency" name="currency" class="form-control" required><option value="TRY">TRY</option><option value="GBP">GBP</option><option value="EUR">EUR</option><option value="USD">USD</option></select></label>
          <label>Minimum Price<input id="price-min" name="minPrice" class="form-control" type="number" min="0" step="0.01" required /></label>
          <label>Maximum Price<input id="price-max" name="maxPrice" class="form-control" type="number" min="0" step="0.01" required /></label>
        </div>
        <label class="service-price-checkbox"><input id="price-active" name="isActive" type="checkbox" value="true" /> Active listing</label>
        <div class="service-price-actions"><button id="delete-service-price" class="service-price-delete" type="button">Delete</button><a class="btn-back" href="/craftsman/service-prices">Cancel</a><button class="btn-primary" type="submit">Save Changes</button></div>
      @end
    </div>
  </section>

  <script>
      const root = document.getElementById('service-price-edit')
      const priceId = root.dataset.priceId
      const form = document.getElementById('service-price-form')
      const category = document.getElementById('price-category')
      const service = document.getElementById('price-sub-service')
      const region = document.getElementById('price-region')
      const errorBox = document.getElementById('service-price-form-error')
      const csrf = form.querySelector('input[name="_csrf"]').value
      const option = (value, label) => new Option(label, value)

      const loadServices = async (selected = '') => {
        service.replaceChildren(option('', 'Loading services...'))
        service.disabled = true
        const response = await fetch(`/api/catalog/categories/${category.value}/sub-services`, { headers: { Accept: 'application/json' } })
        const data = await response.json().catch(() => ({}))
        if (!response.ok) throw new Error(data.message || 'Unable to load services.')
        service.replaceChildren(option('', 'Choose a service'))
        data.data.forEach((item) => service.append(option(item.id, item.nameEn)))
        service.value = String(selected)
        service.disabled = false
      }

      const loadForm = async () => {
        try {
          const [priceResponse, categoriesResponse, regionsResponse] = await Promise.all([
            fetch(`/api/craftsman/service-prices/${priceId}`, { headers: { Accept: 'application/json' }, credentials: 'same-origin' }),
            fetch('/api/catalog/categories', { headers: { Accept: 'application/json' } }),
            fetch('/api/catalog/regions', { headers: { Accept: 'application/json' } }),
          ])
          const priceData = await priceResponse.json().catch(() => ({}))
          const categories = await categoriesResponse.json()
          const regions = await regionsResponse.json()
          if (!priceResponse.ok) throw new Error(priceData.message || 'Unable to load this service price.')
          if (!categoriesResponse.ok || !regionsResponse.ok) throw new Error('Unable to load form options.')
          const price = priceData.servicePriceCatalog
          category.replaceChildren(option('', 'Choose a category'))
          categories.data.forEach((item) => category.append(option(item.id, item.nameEn)))
          category.value = String(price.subService.categoryId)
          region.replaceChildren(option('', 'Choose a region'))
          regions.data.forEach((item) => region.append(option(item.id, item.nameEn)))
          region.value = String(price.regionId)
          await loadServices(price.subServiceId)
          document.getElementById('price-currency').value = price.currency
          document.getElementById('price-min').value = price.minPrice
          document.getElementById('price-max').value = price.maxPrice
          document.getElementById('price-active').checked = Boolean(price.isActive)
          document.getElementById('service-price-form-loading').hidden = true
          document.getElementById('service-price-form-card').hidden = false
        } catch (failure) {
          document.getElementById('service-price-form-loading').hidden = true
          errorBox.textContent = failure.message || 'Unable to load this service price.'
          errorBox.hidden = false
        }
      }

      category.addEventListener('change', () => loadServices().catch((failure) => {
        errorBox.textContent = failure.message
        errorBox.hidden = false
      }))
      form.addEventListener('submit', async (event) => {
        event.preventDefault()
        errorBox.hidden = true
        const submit = form.querySelector('button[type="submit"]')
        submit.disabled = true
        try {
          const body = new FormData(form)
          if (!document.getElementById('price-active').checked) body.set('isActive', 'false')
          const response = await fetch(`/api/craftsman/service-prices/${priceId}`, { method: 'PATCH', body, headers: { Accept: 'application/json', 'x-csrf-token': csrf }, credentials: 'same-origin' })
          const data = await response.json().catch(() => ({}))
          if (!response.ok) throw new Error(data.errors?.[0]?.message || data.message || 'Unable to update service price.')
          window.location.assign('/craftsman/service-prices')
        } catch (failure) {
          errorBox.textContent = failure.message || 'Unable to update service price.'
          errorBox.hidden = false
          submit.disabled = false
        }
      })
      document.getElementById('delete-service-price').addEventListener('click', async () => {
        if (!window.confirm('Delete this service price?')) return
        const response = await fetch(`/api/craftsman/service-prices/${priceId}`, { method: 'DELETE', headers: { Accept: 'application/json', 'x-csrf-token': csrf }, credentials: 'same-origin' })
        if (response.ok) return window.location.assign('/craftsman/service-prices')
        const data = await response.json().catch(() => ({}))
        errorBox.textContent = data.message || 'Unable to delete service price.'
        errorBox.hidden = false
      })
      loadForm()
  </script>
@end
