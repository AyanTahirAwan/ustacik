@dashboardLayout({ title: t('craftsman.create_service_price', {}, 'Create Service Price') })
  <section class="service-price-page">
    <div class="service-price-toolbar">
      <a class="btn-back" href="/craftsman/service-prices">{{ t('craftsman.back_to_prices', {}, 'Back to My Service Prices') }}</a>
    </div>
    <div id="service-price-form-error" class="dashboard-message dashboard-message-error" hidden></div>
    <div id="service-price-form-success" class="dashboard-message" style="background-color: #d1fae5; color: #065f46; border: 1px solid #a7f3d0; padding: 12px 16px; border-radius: 8px; margin-bottom: 16px;" hidden></div>
    
    <div class="dashboard-panel service-price-form-card">
      @form({ method: 'POST', action: '/api/craftsman/service-prices', id: 'service-price-form' })
        <div class="service-price-form-grid">
          <div>
            <label>{{ t('search.category', {}, 'Category / Profession') }}</label>
            <input id="price-category-display" class="form-control" type="text" readonly style="background-color: var(--gray-2, #f3f4f6); cursor: not-allowed; font-weight: 600;" value="{{ t('btn.loading', {}, 'Loading profession...') }}" />
            <input type="hidden" id="price-category-id" name="categoryId" value="" />
            <small class="dashboard-muted" style="display: block; margin-top: 4px;">{{ t('craftsman.category_locked_note', {}, 'Your profession is locked to your registered category.') }}</small>
          </div>

          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
              <label style="margin-bottom: 0;">{{ t('search.service', {}, 'Service') }}</label>
              <button id="toggle-custom-service-btn" type="button" class="action-link" style="background: none; border: none; font-size: 0.85rem; font-weight: 600; cursor: pointer; color: var(--brand-rust, #c85a32);">
                + {{ t('craftsman.add_custom_sub_service', {}, 'Add Custom Sub-Service') }}
              </button>
            </div>
            <select id="price-sub-service" name="subServiceId" class="form-control" required disabled>
              <option value="">{{ t('btn.loading', {}, 'Loading services...') }}</option>
            </select>
          </div>

          <label>{{ t('search.region', {}, 'Region') }}
            <select id="price-region" name="regionId" class="form-control" required>
              <option value="">{{ t('btn.loading', {}, 'Loading regions...') }}</option>
            </select>
          </label>
          <label>{{ t('craftsman.currency', {}, 'Currency') }}
            <select name="currency" class="form-control" required>
              <option value="TRY">TRY</option>
              <option value="GBP">GBP</option>
              <option value="EUR">EUR</option>
              <option value="USD">USD</option>
            </select>
          </label>
          <label>{{ t('search.min_price', {}, 'Minimum Price') }}<input name="minPrice" class="form-control" type="number" min="0" step="0.01" required /></label>
          <label>{{ t('search.max_price', {}, 'Maximum Price') }}<input name="maxPrice" class="form-control" type="number" min="0" step="0.01" required /></label>
        </div>

        <!-- Inline Custom Sub-Service Creator -->
        <div id="custom-service-card" style="margin-top: 16px; padding: 16px; background-color: #f8fafc; border: 1px dashed var(--brand-rust, #c85a32); border-radius: 8px;" hidden>
          <h4 style="margin-top: 0; margin-bottom: 8px; color: #1e293b; font-size: 0.95rem;">{{ t('craftsman.add_custom_sub_service', {}, 'Add Custom Sub-Service') }}</h4>
          <p class="dashboard-muted" style="margin-top: 0; margin-bottom: 12px; font-size: 0.85rem;">{{ t('craftsman.custom_sub_service_desc', {}, 'Create a new sub-service for your category.') }}</p>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
            <label style="font-size: 0.85rem;">{{ t('admin.service_name_en', {}, 'Sub-Service Name (English)') }}
              <input id="custom-service-name-en" class="form-control" type="text" placeholder="e.g. Italian Marble Polishing" />
            </label>
            <label style="font-size: 0.85rem;">{{ t('admin.service_name_tr', {}, 'Sub-Service Name (Turkish)') }}
              <input id="custom-service-name-tr" class="form-control" type="text" placeholder="örn. İtalyan Mermer Cilalama" />
            </label>
          </div>
          <div style="display: flex; gap: 8px; justify-content: flex-end;">
            <button id="cancel-custom-service-btn" type="button" class="btn-back" style="padding: 6px 12px; font-size: 0.85rem;">{{ t('btn.cancel', {}, 'Cancel') }}</button>
            <button id="save-custom-service-btn" type="button" class="btn-primary" style="padding: 6px 14px; font-size: 0.85rem;">{{ t('craftsman.create_sub_service_btn', {}, 'Create Sub-Service') }}</button>
          </div>
        </div>

        <label class="service-price-checkbox" style="margin-top: 16px;"><input name="isActive" type="checkbox" value="true" checked /> {{ t('craftsman.active_listing', {}, 'Active listing') }}</label>
        <div class="service-price-actions"><a class="btn-back" href="/craftsman/service-prices">{{ t('btn.cancel', {}, 'Cancel') }}</a><button class="btn-primary" type="submit">{{ t('craftsman.create_service_price', {}, 'Create Service Price') }}</button></div>
      @end
    </div>
  </section>

  <script>
      const form = document.getElementById('service-price-form')
      const categoryDisplay = document.getElementById('price-category-display')
      const categoryIdInput = document.getElementById('price-category-id')
      const service = document.getElementById('price-sub-service')
      const region = document.getElementById('price-region')
      const errorBox = document.getElementById('service-price-form-error')
      const successBox = document.getElementById('service-price-form-success')
      const customCard = document.getElementById('custom-service-card')
      const toggleCustomBtn = document.getElementById('toggle-custom-service-btn')
      const cancelCustomBtn = document.getElementById('cancel-custom-service-btn')
      const saveCustomBtn = document.getElementById('save-custom-service-btn')
      const customNameEn = document.getElementById('custom-service-name-en')
      const customNameTr = document.getElementById('custom-service-name-tr')
      const csrf = form.querySelector('input[name="_csrf"]')?.value
      const option = (value, label) => new Option(label, value)

      let craftsmanCategory = null

      const loadServices = async (selectedId = null) => {
        if (!craftsmanCategory) return
        service.replaceChildren(option('', "{{ t('btn.loading', {}, 'Loading services...') }}"))
        service.disabled = true
        const response = await fetch(`/api/catalog/categories/${craftsmanCategory.id}/sub-services`, { headers: { Accept: 'application/json' } })
        const data = await response.json().catch(() => ({}))
        if (!response.ok) throw new Error(data.message || "{{ t('dashboard.unable_to_load', {}, 'Unable to load services.') }}")
        service.replaceChildren(option('', "{{ t('search.choose_service', {}, 'Choose a service') }}"))
        data.data.forEach((item) => {
          const opt = option(item.id, window.APP_LOCALE === 'tr' ? (item.nameTr || item.nameEn) : (item.nameEn || item.nameTr))
          service.append(opt)
        })
        if (selectedId) {
          service.value = String(selectedId)
        }
        service.disabled = false
      }

      const loadLookups = async () => {
        try {
          const [profileResponse, regionsResponse] = await Promise.all([
            fetch('/api/craftsman/profile', { headers: { Accept: 'application/json' }, credentials: 'same-origin' }),
            fetch('/api/catalog/regions', { headers: { Accept: 'application/json' } }),
          ])
          const profileData = await profileResponse.json()
          const regions = await regionsResponse.json()
          if (!profileResponse.ok || !profileData.craftsman) throw new Error("{{ t('dashboard.unable_to_load', {}, 'Unable to load profile information.') }}")
          if (!regionsResponse.ok) throw new Error("{{ t('dashboard.unable_to_load', {}, 'Unable to load regions.') }}")

          craftsmanCategory = profileData.craftsman.category
          if (craftsmanCategory) {
            categoryDisplay.value = window.APP_LOCALE === 'tr' ? (craftsmanCategory.nameTr || craftsmanCategory.nameEn) : (craftsmanCategory.nameEn || craftsmanCategory.nameTr)
            categoryIdInput.value = craftsmanCategory.id
            await loadServices()
          }

          region.replaceChildren(option('', "{{ t('search.choose_region', {}, 'Choose a region') }}"))
          regions.data.forEach((item) => region.append(option(item.id, window.APP_LOCALE === 'tr' ? (item.nameTr || item.nameEn) : (item.nameEn || item.nameTr))))
        } catch (failure) {
          errorBox.textContent = failure.message || "{{ t('dashboard.unable_to_load', {}, 'Unable to load form options.') }}"
          errorBox.hidden = false
        }
      }

      toggleCustomBtn.addEventListener('click', () => {
        customCard.hidden = !customCard.hidden
        if (!customCard.hidden) customNameEn.focus()
      })

      cancelCustomBtn.addEventListener('click', () => {
        customCard.hidden = true
        customNameEn.value = ''
        customNameTr.value = ''
      })

      saveCustomBtn.addEventListener('click', async () => {
        errorBox.hidden = true
        successBox.hidden = true
        const nameEn = customNameEn.value.trim()
        const nameTr = customNameTr.value.trim() || nameEn
        if (!nameEn) {
          errorBox.textContent = window.APP_LOCALE === 'tr' ? 'Lütfen alt hizmet adını girin.' : 'Please enter a sub-service name.'
          errorBox.hidden = false
          return
        }

        saveCustomBtn.disabled = true
        try {
          const response = await fetch('/api/craftsman/sub-services', {
            method: 'POST',
            headers: {
              'Accept': 'application/json',
              'Content-Type': 'application/json',
              'x-csrf-token': csrf,
            },
            credentials: 'same-origin',
            body: JSON.stringify({
              nameEn,
              nameTr,
              categoryId: craftsmanCategory.id,
            }),
          })
          const payload = await response.json().catch(() => ({}))
          if (!response.ok || !payload.subService) {
            throw new Error(payload.errors?.[0]?.message || payload.message || "{{ t('dashboard.unable_to_save', {}, 'Unable to create sub-service.') }}")
          }

          await loadServices(payload.subService.id)
          customCard.hidden = true
          customNameEn.value = ''
          customNameTr.value = ''
          successBox.textContent = "{{ t('craftsman.sub_service_created', {}, 'Custom sub-service added successfully.') }}"
          successBox.hidden = false
        } catch (err) {
          errorBox.textContent = err.message || "{{ t('dashboard.unable_to_save', {}, 'Unable to create sub-service.') }}"
          errorBox.hidden = false
        } finally {
          saveCustomBtn.disabled = false
        }
      })

      form.addEventListener('submit', async (event) => {
        event.preventDefault()
        errorBox.hidden = true
        const submit = form.querySelector('button[type="submit"]')
        submit.disabled = true
        try {
          const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' }, credentials: 'same-origin' })
          const data = await response.json().catch(() => ({}))
          if (!response.ok) throw new Error(data.errors?.[0]?.message || data.message || "{{ t('dashboard.unable_to_save', {}, 'Unable to create service price.') }}")
          window.location.assign('/craftsman/service-prices')
        } catch (failure) {
          errorBox.textContent = failure.message || "{{ t('dashboard.unable_to_save', {}, 'Unable to create service price.') }}"
          errorBox.hidden = false
          submit.disabled = false
        }
      })

      loadLookups()
  </script>
@end
