@dashboardLayout({ title: t('nav.work_photos', {}, 'Work Photos') })
  <section class="work-photos-page" data-work-photos>
    <div class="work-photos-toolbar">
      <a class="btn-back" href="/craftsman">{{ t('craftsman.back_to_dashboard', {}, 'Back to Dashboard') }}</a>
    </div>

    <div id="work-photos-loading" class="dashboard-message">{{ t('btn.loading', {}, 'Loading your work photos...') }}</div>
    <div id="work-photos-error" class="dashboard-message dashboard-message-error" hidden></div>
    <div id="work-photos-success" class="dashboard-message work-photos-success" hidden></div>

    <section id="work-photos-content" hidden>
      <article class="dashboard-panel work-photo-form-card">
        <h2>{{ t('craftsman.add_work_photo', {}, 'Add Work Photo') }}</h2>
        <p class="dashboard-muted">
          {{ t('craftsman.upload_photo_desc', {}, 'Upload a photo of your previous work. Supported formats: JPG, PNG, WebP (Max 5MB).') }}
        </p>

        <div class="work-photo-form-row">
          <label for="work-photo-input">
            {{ t('craftsman.choose_photo', {}, 'Choose Photo') }}
            <input
              id="work-photo-input"
              class="form-control"
              type="file"
              accept="image/jpeg,image/png,image/webp"
              required
            />
          </label>
          <button id="work-photo-add" class="btn-primary" type="button">{{ t('craftsman.upload_btn', {}, 'Upload Photo') }}</button>
        </div>
      </article>

      <section class="dashboard-panel">
        <div class="dashboard-panel-heading">
          <div>
            <h2>{{ t('craftsman.portfolio', {}, 'Portfolio') }}</h2>
            <p class="dashboard-muted">{{ t('craftsman.saved_work_photos', {}, 'Your saved work photos.') }}</p>
          </div>
        </div>
        <div id="work-photos-empty" class="dashboard-empty" hidden>{{ t('craftsman.no_photos_added', {}, 'You have not added any work photos yet.') }}</div>
        <div id="work-photos-list" class="work-photos-grid"></div>
      </section>
    </section>
  </section>

  <script>
    const workPhotosLoading = document.getElementById('work-photos-loading')
    const workPhotosContent = document.getElementById('work-photos-content')
    const workPhotosError = document.getElementById('work-photos-error')
    const workPhotosSuccess = document.getElementById('work-photos-success')
    const workPhotosEmpty = document.getElementById('work-photos-empty')
    const workPhotosList = document.getElementById('work-photos-list')
    const workPhotoInput = document.getElementById('work-photo-input')
    const workPhotoAdd = document.getElementById('work-photo-add')
    
    // Get CSRF token from meta tag
    const workPhotoCsrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || ''
    let workPhotos = []
    const isTr = window.APP_LOCALE === 'tr'

    if (isTr) {
      if (workPhotoAdd) workPhotoAdd.textContent = 'Fotoğraf Yükle'
      const label = document.querySelector('label[for="work-photo-input"]')
      if (label && label.childNodes.length > 0) {
        label.childNodes[0].textContent = 'Fotoğraf Seç '
      }
    }

    const showWorkPhotoError = (message) => {
      workPhotosError.textContent = message
      workPhotosError.hidden = false
      workPhotosSuccess.hidden = true
    }

    const showWorkPhotoSuccess = (message) => {
      workPhotosSuccess.textContent = message
      workPhotosSuccess.hidden = false
      workPhotosError.hidden = true
    }

    const renderWorkPhotos = () => {
      workPhotosList.replaceChildren()
      workPhotosEmpty.hidden = workPhotos.length !== 0

      workPhotos.forEach((workPhoto) => {
        console.log('Rendering photo:', { id: workPhoto.id, imageUrl: workPhoto.imageUrl })
        
        const card = document.createElement('article')
        const image = document.createElement('img')
        const url = document.createElement('p')
        const remove = document.createElement('button')
        card.className = 'work-photo-card'
        image.className = 'work-photo-image'
        image.src = workPhoto.imageUrl
        image.alt = 'Craftsman work portfolio'
        image.loading = 'lazy'
        
        // Log when image fails to load
        image.addEventListener('error', () => {
          console.error('Failed to load image:', workPhoto.imageUrl)
        })
        
        image.addEventListener('load', () => {
          console.log('Image loaded successfully:', workPhoto.imageUrl)
        })
        
        url.className = 'work-photo-url'
        url.textContent = workPhoto.imageUrl
        remove.className = 'service-price-delete work-photo-remove'
        remove.type = 'button'
        remove.textContent = isTr ? 'Fotoğrafı Kaldır' : 'Remove Photo'

        remove.addEventListener('click', async () => {
          if (!window.confirm(isTr ? 'Bu çalışma fotoğrafını kaldırmak istiyor musunuz?' : 'Remove this work photo?')) return
          remove.disabled = true
          remove.textContent = isTr ? 'Kaldırılıyor...' : 'Removing...'
          try {
            const response = await fetch(`/api/craftsman/work-photos/${workPhoto.id}`, {
              method: 'DELETE',
              headers: { Accept: 'application/json', 'x-csrf-token': workPhotoCsrf },
              credentials: 'same-origin',
            })
            if (!response.ok) throw new Error(isTr ? 'Çalışma fotoğrafı kaldırılamadı.' : 'Unable to remove the work photo.')
            workPhotos = workPhotos.filter((photo) => photo.id !== workPhoto.id)
            renderWorkPhotos()
            showWorkPhotoSuccess(isTr ? 'Çalışma fotoğrafı kaldırıldı.' : 'The work photo has been removed.')
          } catch (failure) {
            remove.disabled = false
            remove.textContent = isTr ? 'Fotoğrafı Kaldır' : 'Remove Photo'
            showWorkPhotoError(failure.message || (isTr ? 'Çalışma fotoğrafı kaldırılamadı.' : 'Unable to remove the work photo.'))
          }
        })

        card.append(image, url, remove)
        workPhotosList.appendChild(card)
      })
    }

    const loadWorkPhotos = async () => {
      try {
        const response = await fetch('/api/craftsman/work-photos', {
          headers: { Accept: 'application/json' },
          credentials: 'same-origin',
        })
        const payload = await response.json().catch(() => ({}))
        console.log('Work photos response:', { status: response.status, ok: response.ok, payload })
        
        if (!response.ok) {
          throw new Error(payload.message || `HTTP ${response.status}: ${isTr ? 'Çalışma fotoğraflarınız yüklenemedi.' : 'Unable to load your work photos.'}`)
        }
        
        if (!Array.isArray(payload.workPhotos)) {
          throw new Error('Invalid response format: workPhotos is not an array')
        }
        
        workPhotos = payload.workPhotos
        renderWorkPhotos()
        workPhotosLoading.hidden = true
        workPhotosContent.hidden = false
      } catch (failure) {
        console.error('Error loading work photos:', failure)
        workPhotosLoading.hidden = true
        showWorkPhotoError(failure.message || (isTr ? 'Çalışma fotoğraflarınız yüklenemedi.' : 'Unable to load your work photos.'))
      }
    }

    workPhotoAdd.addEventListener('click', async () => {
      const file = workPhotoInput.files[0]
      
      if (!file) {
        showWorkPhotoError(isTr ? 'Lütfen yüklemek için bir fotoğraf seçin.' : 'Please select a photo to upload.')
        return
      }

      workPhotosError.hidden = true
      workPhotosSuccess.hidden = true
      workPhotoAdd.disabled = true
      workPhotoAdd.textContent = isTr ? 'Yükleniyor...' : 'Uploading...'
      
      try {
        const formData = new FormData()
        formData.append('image', file)

        const response = await fetch('/api/craftsman/work-photos', {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'x-csrf-token': workPhotoCsrf,
          },
          credentials: 'same-origin',
          body: formData,
        })
        
        const payload = await response.json().catch(() => ({}))
        console.log('Upload response:', { status: response.status, ok: response.ok, payload })
        
        if (!response.ok) {
          throw new Error(payload.message || `HTTP ${response.status}: ${isTr ? 'Çalışma fotoğrafı eklenemedi.' : 'Unable to add the work photo.'}`)
        }
        
        if (!payload.workPhoto) {
          throw new Error('Invalid response format: workPhoto is missing')
        }
        
        workPhotos = [payload.workPhoto, ...workPhotos]
        renderWorkPhotos()
        workPhotoInput.value = ''
        showWorkPhotoSuccess(isTr ? 'Çalışma fotoğrafı başarıyla eklendi.' : 'The work photo has been added successfully.')
      } catch (failure) {
        console.error('Error uploading photo:', failure)
        showWorkPhotoError(failure.message || (isTr ? 'Çalışma fotoğrafı eklenemedi.' : 'Unable to add the work photo.'))
      } finally {
        workPhotoAdd.disabled = false
        workPhotoAdd.textContent = isTr ? 'Fotoğraf Yükle' : 'Upload Photo'
      }
    })

    loadWorkPhotos()
  </script>
@end
