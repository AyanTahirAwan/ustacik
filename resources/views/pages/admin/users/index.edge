@adminUserLayout({ title: t('admin.user_management', {}, 'User Management'), active: 'users' })
  <div id="admin-users-page" class="admin-users-page">
    <section class="admin-users-intro">
      <div>
        <p class="admin-users-kicker">{{ t('admin.kicker', {}, 'Platform Administration') }}</p>
        <h2>{{ t('admin.user_management', {}, 'User Management') }}</h2>
        <p>
          {{ t('admin.user_management_sub', {}, 'Review registered accounts and filter users by role or account status.') }}
        </p>
      </div>
    </section>

    <div
      id="admin-users-error"
      class="alert alert-destructive admin-users-message"
      hidden
    >
      <p id="admin-users-error-message"></p>
    </div>

    <section class="admin-users-panel">
      <form id="admin-users-filter-form" class="admin-users-filter-bar">
        <div class="form-group">
          <label class="form-label" for="admin-users-role">
            {{ t('admin.role', {}, 'Role') }}
          </label>

          <select id="admin-users-role" class="form-control">
            <option value="">{{ t('admin.all_roles', {}, 'All roles') }}</option>
            <option value="customer">{{ t('admin.customer', {}, 'Customer') }}</option>
            <option value="craftsman">{{ t('admin.craftsman', {}, 'Craftsman') }}</option>
            <option value="admin">{{ t('admin.admin', {}, 'Admin') }}</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="admin-users-status">
            {{ t('admin.status', {}, 'Status') }}
          </label>

          <select id="admin-users-status" class="form-control">
            <option value="">{{ t('admin.all_statuses', {}, 'All statuses') }}</option>
            <option value="active">{{ t('admin.active', {}, 'Active') }}</option>
            <option value="suspended">{{ t('admin.suspended', {}, 'Suspended') }}</option>
          </select>
        </div>

        <div class="admin-users-filter-actions">
          <button class="btn-primary" type="submit">
            {{ t('admin.apply_filters', {}, 'Apply Filters') }}
          </button>

          <button
            id="admin-users-filter-reset"
            class="btn-back"
            type="button"
          >
            {{ t('admin.reset', {}, 'Reset') }}
          </button>
        </div>
      </form>

      <div class="admin-users-panel-heading">
        <div>
          <h3>{{ t('admin.platform_users', {}, 'Platform Users') }}</h3>
          <p>
            <span id="admin-users-count">0</span>
            {{ t('admin.users_found', {}, 'user(s) found.') }}
          </p>
        </div>
      </div>

      <p id="admin-users-loading" class="admin-users-loading">
        {{ t('btn.loading', {}, 'Loading users...') }}
      </p>

      <p id="admin-users-empty" class="admin-users-empty" hidden>
        {{ t('admin.no_users_found', {}, 'No users match the selected filters.') }}
      </p>

      <div
        id="admin-users-table-wrapper"
        class="admin-users-table-wrapper"
        hidden
      >
        <table class="admin-users-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>{{ t('admin.user', {}, 'User') }}</th>
              <th>{{ t('auth.email', {}, 'Email') }}</th>
              <th>{{ t('admin.role', {}, 'Role') }}</th>
              <th>{{ t('admin.status', {}, 'Status') }}</th>
              <th>{{ t('admin.account_actions', {}, 'Action') }}</th>
            </tr>
          </thead>

          <tbody id="admin-users-table-body"></tbody>
        </table>
      </div>
    </section>
  </div>

  @vite(['resources/js/admin-users.js'])
@end
