@adminUserLayout({ title: t('admin.user_details', {}, 'User Details'), active: 'users' })
  <div
    id="admin-user-detail-page"
    class="admin-user-detail-page"
    data-user-id="{{ userId }}"
  >
    <section class="admin-user-detail-intro">
      <div>
        <p class="admin-users-kicker">{{ t('admin.user_management', {}, 'User Management') }}</p>
        <h2>{{ t('admin.user_details', {}, 'User Details') }}</h2>
        <p>
          {{ t('admin.user_management_sub', {}, 'Review account information and role-specific profile data.') }}
        </p>
      </div>

      <a href="/admin/users" class="btn-back admin-user-back">
        {{ t('admin.back_to_users', {}, 'Back to Users') }}
      </a>
    </section>

    <div
      id="admin-user-detail-error"
      class="alert alert-destructive admin-users-message"
      hidden
    >
      <p id="admin-user-detail-error-message"></p>
    </div>

    <div
      id="admin-user-detail-success"
      class="alert alert-success admin-users-message"
      hidden
    >
      <p id="admin-user-detail-success-message"></p>
    </div>

    <p id="admin-user-detail-loading" class="admin-users-loading">
      {{ t('btn.loading', {}, 'Loading user...') }}
    </p>

    <section
      id="admin-user-detail-content"
      class="admin-user-detail-panel"
      hidden
    >
      <div class="admin-user-summary">
        <div>
          <h3 id="admin-user-display-name"></h3>
          <p id="admin-user-email"></p>
        </div>

        <div class="admin-user-summary-badges">
          <span id="admin-user-role" class="admin-user-badge"></span>
          <span id="admin-user-status" class="admin-user-badge"></span>
        </div>
      </div>

      <div class="admin-user-section">
        <div class="admin-user-section-heading">
          <h3>{{ t('admin.account_info', {}, 'Account Information') }}</h3>
        </div>

        <dl class="admin-user-detail-grid">
          <div>
            <dt>{{ t('admin.user_id', {}, 'User ID') }}</dt>
            <dd id="admin-user-id"></dd>
          </div>

          <div>
            <dt>{{ t('admin.phone', {}, 'Phone') }}</dt>
            <dd id="admin-user-phone"></dd>
          </div>

          <div>
            <dt>{{ t('admin.created', {}, 'Created') }}</dt>
            <dd id="admin-user-created"></dd>
          </div>

          <div>
            <dt>{{ t('admin.updated', {}, 'Updated') }}</dt>
            <dd id="admin-user-updated"></dd>
          </div>
        </dl>
      </div>

      <div class="admin-user-section">
        <div class="admin-user-section-heading">
          <h3>{{ t('admin.role_details', {}, 'Role Details') }}</h3>
          <p>
            {{ t('admin.role_info_sub', {}, 'Information associated with this user\'s current role.') }}
          </p>
        </div>

        <dl
          id="admin-user-role-details"
          class="admin-user-detail-grid"
        ></dl>
      </div>

      <div class="admin-user-section admin-user-action-section">
        <div class="admin-user-section-heading">
          <h3>{{ t('admin.account_actions') }}</h3>
          <p>
            {{ t('admin.manage_access', {}, 'Manage administrative status and access restrictions for this account.') }}
          </p>
        </div>

        @form({
          action: '/api/admin/users',
          method: 'POST',
          id: 'admin-user-action-form'
        })
          <button
            id="admin-user-suspend"
            class="btn-primary"
            type="button"
          >
            {{ t('admin.suspend_user') }}
          </button>
          <button
            id="admin-user-unsuspend"
            class="btn-primary"
            style="background-color: #059669;"
            type="button"
            hidden
          >
            {{ t('admin.unsuspend_user') }}
          </button>
          <button
            id="admin-user-delete"
            class="btn-primary"
            style="background-color: #dc2626; color: #ffffff; border: none; margin-left: 10px;"
            type="button"
          >
            {{ t('admin.delete_user', {}, 'Delete Account') }}
          </button>
        @end

        <p
          id="admin-user-already-suspended"
          class="admin-user-suspended-note"
          hidden
        >
          {{ t('admin.account_suspended') }}
        </p>
      </div>
    </section>
  </div>

  @vite(['resources/js/admin-user-detail.js'])
@end
