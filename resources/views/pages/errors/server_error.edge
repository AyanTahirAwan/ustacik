<!DOCTYPE html>
<html lang="{{ lang || 'en' }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ error.code }} - {{ t('error.server_error_title', {}, 'Server error') }}</title>
    @vite(['resources/css/app.css'])
  </head>
  <body>
    <section class="error-page">
      <div class="error-card">
        <div class="error-code">{{ error.code }}</div>
        <h1>{{ t('error.server_error', {}, 'Server error') }}</h1>
        <p>
          {{ t('error.500_desc', {}, 'Something went wrong on our end. Please try again shortly, or go back to the home page.') }}
        </p>
        <div class="error-actions">
          <a class="btn-primary" href="/">{{ t('error.back_to_home', {}, 'Back to Home') }}</a>
        </div>
      </div>
    </section>
  </body>
</html>
