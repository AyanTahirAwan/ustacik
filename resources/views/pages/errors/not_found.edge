<!DOCTYPE html>
<html lang="{{ lang || 'en' }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ t('error.404_title', {}, '404 - Page not found') }}</title>
    @vite(['resources/css/app.css'])
  </head>
  <body>
    <section class="error-page">
      <div class="error-card">
        <div class="error-code">404</div>
        <h1>{{ t('error.page_not_found', {}, 'Page not found') }}</h1>
        <p>
          {{ t('error.404_desc', {}, "The page you are looking for doesn't exist, may have been removed, or the link may be broken.") }}
        </p>
        <div class="error-actions">
          <a class="btn-primary" href="/">{{ t('error.back_to_home', {}, 'Back to Home') }}</a>
        </div>
      </div>
    </section>
  </body>
</html>
