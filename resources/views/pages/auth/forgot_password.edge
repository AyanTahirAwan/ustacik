@layout()
  <div class="auth-wrapper">
    <div class="auth-card">
      <div class="auth-card-header">
        <h1>{{ t('auth.forgot_password_heading', {}, 'Forgot password?') }}</h1>
        <p>{{ t('auth.forgot_password_sub', {}, 'Enter your email address and we’ll send a password-reset link if an account exists.') }}</p>
      </div>
      @form({ action: '/forgot-password', method: 'POST' })
        <div class="auth-field">
          @field.root({ name: 'email' })
            @!field.label({ text: t('auth.email', {}, 'Email address') })
            @!input.control({ type: 'email', autocomplete: 'email' })
            @!field.error()
          @end
        </div>
        <div class="auth-actions">
          @!button({ text: t('auth.send_reset_link', {}, 'Send reset link'), type: 'submit', class: 'btn-primary' })
        </div>
      @end
    </div>
  </div>
@end
