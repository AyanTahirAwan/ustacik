@layout()
  <div class="auth-wrapper">
    <div class="auth-card">
      <div class="auth-card-header">
        <h1>Reset password</h1>
        <p>
          Choose a new password with at least 12 characters, including uppercase, lowercase, and a number.
        </p>
      </div>
      @form({ action: `/password-reset/${token}`, method: 'POST' })
        <div class="auth-field">
          @field.root({ name: 'password' })
            @!field.label({ text: 'New password' })
            @!input.control({ type: 'password', autocomplete: 'new-password' })
            @!field.error()
          @end
        </div>
        <div class="auth-field">
          @field.root({ name: 'passwordConfirmation' })
            @!field.label({ text: 'Confirm new password' })
            @!input.control({ type: 'password', autocomplete: 'new-password' })
            @!field.error()
          @end
        </div>
        <div class="auth-actions">
          @!button({ text: 'Reset password', type: 'submit', class: 'btn-primary' })
        </div>
      @end
    </div>
  </div>
@end
