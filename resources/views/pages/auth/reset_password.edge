@layout()
  <div class="auth-wrapper">
    <div class="auth-card">
      <div class="auth-card-header">
        <h1>{{ t('auth.reset_password_heading', {}, 'Reset password') }}</h1>
        <p>
          {{ t('auth.reset_password_sub', {}, 'Choose a new password with at least 12 characters, including uppercase, lowercase, and a number.') }}
        </p>
      </div>
      @form({ action: `/password-reset/${token}`, method: 'POST' })
        <div class="auth-field">
          @field.root({ name: 'password' })
            @!field.label({ text: t('auth.new_password', {}, 'New password') })
            @!input.control({ type: 'password', autocomplete: 'new-password' })
            @!field.error()
          @end
        </div>
        <div class="auth-field">
          @field.root({ name: 'passwordConfirmation' })
            @!field.label({ text: t('auth.confirm_new_password', {}, 'Confirm new password') })
            @!input.control({ type: 'password', autocomplete: 'new-password' })
            @!field.error()
          @end
        </div>
        <div class="auth-actions">
          @!button({ text: t('auth.reset_password_heading', {}, 'Reset password'), type: 'submit', class: 'btn-primary' })
        </div>
      @end
    </div>
  </div>
@end
