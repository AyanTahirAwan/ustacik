@layout()
  <div class="auth-wrapper">
    <div class="auth-card">
      <div class="auth-card-header">
        <h1>Signup</h1>
        <p>Enter your details below to create your account</p>
      </div>

      <div>
        @form({ route: 'new_account.store', method: 'POST' })
          <div class="auth-field">
            @field.root({ name: 'fullName' })
              @!field.label({ text: 'Full name' })
              @!input.control()
              @!field.error()
            @end
          </div>

          <div class="auth-field">
            @field.root({ name: 'email' })
              @!field.label({ text: 'Email' })
              @!input.control({ type: 'email', autocomplete: 'email' })
              @!field.error()
            @end
          </div>

          <div class="auth-field">
            @field.root({ name: 'phone' })
              @!field.label({ text: 'Phone number' })
              @!input.control({
                type: 'tel',
                autocomplete: 'tel',
                placeholder: '+905551234567',
                inputmode: 'tel',
                'aria-describedby': 'phone-format-note',
              })
              @!field.error()
            @end

            <p id="phone-format-note" class="signup-help">
              Use international format:
              <strong>+905551234567</strong>
              (a + followed by country code and number).
            </p>
          </div>

          <div class="auth-field">
            @field.root({ name: 'role' })
              @!field.label({ text: 'Account type' })
              @!select.control({
                options: [
                  { value: 'customer', name: 'Customer' },
                  { value: 'craftsman', name: 'Craftsman' },
                ],
              })
              @!field.error()
            @end
          </div>

          <div id="craftsman-signup-fields" hidden>
            <div class="auth-field">
              @field.root({ name: 'businessName' })
                @!field.label({ text: 'Business name' })
                @!input.control({ autocomplete: 'organization' })
                @!field.error()
              @end
            </div>

            <div class="auth-field">
              @field.root({ name: 'categoryId' })
                @!field.label({ text: 'Service category' })
                @!select.control({
                  id: 'signup-category-select',
                  options: [{ value: '', name: 'Loading categories…' }],
                })
                @!field.error()
              @end
            </div>
          </div>

          <div class="auth-field">
            @field.root({ name: 'password' })
              @!field.label({ text: 'Password' })
              @!input.control({
                type: 'password',
                autocomplete: 'new-password',
                'aria-describedby':
                  'password-requirements password-strength-label',
              })
              @!field.error()
            @end

            <p id="password-requirements" class="signup-help">
              Use 12+ characters with uppercase, lowercase, and a number.
            </p>
            <div class="password-strength" aria-live="polite">
              <div
                class="password-strength-track"
                role="progressbar"
                aria-label="Password strength"
                aria-valuemin="0"
                aria-valuemax="4"
                aria-valuenow="0"
              >
                <span class="password-strength-fill"></span>
              </div>
              <p id="password-strength-label" class="password-strength-label">
                Password strength: not entered
              </p>
            </div>
          </div>

          <div class="auth-field">
            @field.root({ name: 'passwordConfirmation' })
              @!field.label({ text: 'Confirm password' })
              @!input.control({ type: 'password', autocomplete: 'new-password' })
              @!field.error()
            @end
          </div>

          <div class="auth-actions">
            @!button({ text: 'Sign up', type: 'submit', class: 'btn-primary' })
          </div>
        @end
      </div>
    </div>
  </div>
@end
