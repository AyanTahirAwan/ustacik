@layout()
  <div class="auth-wrapper">
    <div class="auth-card">
      <div class="auth-card-header">
        <h1>{{ t('nav.login', {}, 'Login') }}</h1>
        <p>{{ t('auth.login_sub', {}, 'Enter your email and password below to log in') }}</p>
      </div>

      <div>
        @form({ route: 'session.store', method: 'POST' })
          <div class="auth-field">
            @field.root({ name: 'email' })
              @!field.label({ text: t('auth.email', {}, 'Email') })
              @!input.control({ type: 'email' })
              @!field.error()
            @end
          </div>

          <div class="auth-field">
            @field.root({ name: 'password' })
              @!field.label({ text: t('auth.password', {}, 'Password') })
              @!input.control({ type: 'password' })
              @!field.error()
            @end
          </div>

          <div class="auth-actions">
            @!button({ text: t('nav.login', {}, 'Login'), type: 'submit', class: 'btn-primary' })
          </div>
          <p><a href="/forgot-password">{{ t('auth.forgot_password_link', {}, 'Forgot password?') }}</a></p>
        @end
      </div>
    </div>
  </div>
@end
